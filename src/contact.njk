---
layout: base.njk
title: Contact
description: Get in touch with Jannic Spinners for quotes, orders, and enquiries. Located in Gayaza and Kampala, Uganda.
---

<div class="page-hero">
    <div class="section-label">Contact</div>
    <h1>Get in touch</h1>
    <p>Ready to place an order or need a quote? Reach us by WhatsApp, email, or the form below — we'll respond within 24 hours.</p>
</div>

<section class="section alt-bg">
    <div class="section-inner">
        <div class="contact-grid">
            <div class="contact-info">
                <div class="contact-item">
                    <div class="contact-icon-wrap">📍</div>
                    <div class="contact-item-text">
                        <strong>Main Location</strong>
                        <span>Gayaza, Uganda</span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon-wrap">🏢</div>
                    <div class="contact-item-text">
                        <strong>Branch Office</strong>
                        <span>Kampala, Uganda</span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon-wrap">✉️</div>
                    <div class="contact-item-text">
                        <strong>Email</strong>
                        <span><a href="mailto:jackiemagulu@gmail.com" style="color: var(--accent); text-decoration: none;">jackiemagulu@gmail.com</a></span>
                    </div>
                </div>
                <div class="contact-item">
                    <div class="contact-icon-wrap">⏰</div>
                    <div class="contact-item-text">
                        <strong>Business Hours</strong>
                        <span>Mon – Sat: 8:00 AM – 6:00 PM<br>Sunday: Closed</span>
                    </div>
                </div>
                <div>
                    <a href="https://wa.me/256783169770" class="whatsapp-btn" target="_blank" rel="noopener">
                        💬 Chat on WhatsApp
                    </a>
                </div>
            </div>

            <div class="contact-form">
                <h3>Send a message</h3>
                <form action="https://formspree.io/f/xpwygwpd" method="POST">
                    <div class="form-group">
                        <label for="name">Your name</label>
                        <input type="text" id="name" name="name" placeholder="e.g. John Mukasa" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone number</label>
                        <input type="tel" id="phone" name="phone" placeholder="+256 7XX XXX XXX" required>
                    </div>
                    <div class="form-group">
                        <label for="service">Service needed</label>
                        <select id="service" name="service">
                            <option value="">Select a service…</option>
                            <option>Sweater Manufacturing</option>
                            <option>Custom Embroidery</option>
                            <option>Badge Printing</option>
                            <option>Corporate Uniforms</option>
                            <option>School Uniforms</option>
                            <option>Security Uniforms</option>
                            <option>Personal Order</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" placeholder="Tell us quantities, colours, deadline, and any other details…" required></textarea>
                    </div>
                    <button type="submit" class="submit-btn">Send message</button>
                </form>
            </div>
        </div>
    </div>
</section>
