        <li>Email: <a href="mailto:jackiemagulu@gmail.com">jackiemagulu@gmail.com</a></li>
        <li>WhatsApp: +256 783 169770</li>
        <li>Location: Gayaza &amp; Kampala, Uganda</li>
    </ul>
